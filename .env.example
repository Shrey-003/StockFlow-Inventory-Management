# PostgreSQL configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=stockflow
DB_USER=your_postgres_username
DB_PASSWORD=your_postgres_password

# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Authentication configuration
# Generate separate random secrets of at least 32 characters.
# Never commit your actual .env file or share these secret values.
JWT_SECRET_KEY=
WORKER_API_TOKEN=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Login rate limiting
LOGIN_RATE_LIMIT_SECRET=
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_IP_USERNAME_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_IP_MAX_ATTEMPTS=60

# Reservation expiry worker
EXPIRY_WORKER_API_URL=http://127.0.0.1:8000
EXPIRY_WORKER_INTERVAL_SECONDS=30
EXPIRY_WORKER_REQUEST_TIMEOUT_SECONDS=10
EXPIRY_WORKER_MAX_BACKOFF_SECONDS=300